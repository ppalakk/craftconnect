# =========================================================
# CraftConnect Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# =========================================================

# Server Port (assigned by host in production, e.g., Render, Heroku)
PORT=3000
NODE_ENV=development

# Session Encryption Secrets
SECRET=your_super_secret_session_key_here
SESSION_SECRET=your_super_secret_session_key_here

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/craftconnect?retryWrites=true&w=majority
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/craftconnect

# Cloudinary CDN Image Storage
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Google Places API (Optional - for live nearby craft store searches)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Google Gemini API Key (For AI Vision Scan & Multilingual Assistant)
GEMINI_API_KEY=your_gemini_api_key
