# CraftConnect Server Configuration
PORT=3000
SESSION_SECRET=craftconnect-sih-2026-secret

# Database (Optional: falls back to local JSON stores if unavailable)
MONGO_URI=mongodb://127.0.0.1:27017/craftconnect

# Location & Place Search Providers
# Google Places API (New): Used for live nearby business discovery (pottery stores, boutiques, handicraft shops)
# Documentation: https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=

# Geocoding API: Optional backend key for Google Geocoding (OpenStreetMap Nominatim is used by default)
GEOCODING_API_KEY=

# Marketplace Authorized API Integration Credentials (Optional: required for authorized direct sync)
# Amazon SP-API (Selling Partner API)
# Documentation: https://developer-docs.amazon.com/sp-api/
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=

# Flipkart Marketplace API
# Documentation: https://seller.flipkart.com/api-docs/
FLIPKART_SELLER_APP_ID=
FLIPKART_SELLER_APP_SECRET=
