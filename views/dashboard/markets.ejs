      `).join('');
    }

    function renderFairs() {
      const container = document.getElementById('fairsContainer');
      const fairs = getFilteredFairs();

      if (fairs.length === 0) {
        container.innerHTML = `
          <div class="cc-empty-card">
            <span>🔍</span>
            <h4>No exhibitions match your search</h4>
            <p>Try expanding keywords or date range.</p>
          </div>`;
        return;
      }

      container.innerHTML = fairs.map(f => `
        <div class="cc-fair-card-v2">
          <div class="cc-fair-thumb-wrap">
            <img src="${f.image}" alt="${f.name}" class="cc-fair-thumb-v2" onerror="this.onerror=null; this.src='/images/hero_crafts.jpg';">
            <span class="cc-fair-dist-badge">📍 ${f.distance < 10 ? f.distance+' km' : Math.round(f.distance)+' km'}</span>
          </div>
          <div class="cc-fair-body">
            <div class="cc-fair-badges-row">
              <span class="cc-fair-status-pill ${f.statusClass}">${f.status}</span>
              ${f.daysLeft <= 14 ? `<span class="cc-fair-urgency">⏰ ${f.daysLeft}d left to apply</span>` : ''}
            </div>
            <h4 class="cc-fair-title-v2" title="${f.name}">${f.name}</h4>
            <div class="cc-fair-meta-grid">
              <div class="cc-fair-meta-item"><span>📅</span> ${f.dates}</div>
              <div class="cc-fair-meta-item"><span>📍</span> ${f.location}</div>
              <div class="cc-fair-meta-item"><span>🏛️</span> ${f.organizer}</div>
              <div class="cc-fair-meta-item"><span>🎟️</span> Stall: ${f.stallFee}</div>
              <div class="cc-fair-meta-item"><span>📋</span> ${f.eligibility}</div>
              <div class="cc-fair-meta-item"><span>⏳</span> Deadline: ${f.deadline}</div>
            </div>
            <div class="cc-fair-actions">
              <a href="${f.applyLink}" target="_blank" rel="noopener noreferrer" class="cc-btn-apply">
                Apply Now ↗
              </a>
              <a href="https://www.google.com/maps/dir/?api=1&destination=${f.lat},${f.lng}" target="_blank" rel="noopener noreferrer" class="cc-btn-fair-directions">
                📍 Directions
              </a>
            </div>
          </div>
        </div>
      `).join('');
    }

    // ==================== FILTERING LOGIC ====================
    function getFilteredStores() {
      const query = (document.getElementById('marketKeywordInput')?.value || '').toLowerCase();
      return allStores.filter(s => {
        if (s.distance > currentRadius) return false;
        if (query) {
          const searchable = `${s.name} ${s.tags.join(' ')} ${s.address} ${s.description}`.toLowerCase();
          return searchable.includes(query);
        }
        return true;
      });
    }

    function getFilteredOnline() {
      const query = (document.getElementById('marketKeywordInput')?.value || '').toLowerCase();
      return onlinePlatforms.filter(p => {
        if (query) {
          const searchable = `${p.name} ${p.tags.join(' ')} ${p.description} ${p.commission}`.toLowerCase();
          return searchable.includes(query);
        }
        return true;
      });
    }

    function getFilteredFairs() {
      const query = (document.getElementById('marketKeywordInput')?.value || '').toLowerCase();
      return fairsData.filter(f => {
        if (query) {
          const searchable = `${f.name} ${f.location} ${f.organizer} ${f.eligibility} ${f.description}`.toLowerCase();
          return searchable.includes(query);
        }
        return true;
      });
    }

    function filterAllContent() {
      renderLocalStores();
      renderOnlinePlatforms();
      renderFairs();
      updateResultsCounts();
      addMapMarkers();
      updateSectionVisibility();
    }

    function updateRadius(val) {
      currentRadius = parseInt(val, 10);
      const radSelect = document.getElementById('radiusSelect');
      if (radSelect && radSelect.value !== String(currentRadius)) {
        radSelect.value = String(currentRadius);
      }
      drawRadiusCircle();
      renderLocalStores();
      renderFairs();
      updateResultsCounts();
      addMapMarkers();

      if (mapInstance) {
        if (currentRadius <= 10) mapInstance.setZoom(14);
        else if (currentRadius <= 25) mapInstance.setZoom(13);
        else mapInstance.setZoom(11);
      }
    }

    function selectTab(tabKey, btn) {
      currentTab = tabKey;
      document.querySelectorAll(".cc-tab-pill").forEach(el => el.classList.remove("active"));
      if (btn) btn.classList.add("active");
      updateSectionVisibility();
    }

    function updateSectionVisibility() {
      const local = document.getElementById('localSection');
      const online = document.getElementById('onlineSection');
      const fairs = document.getElementById('fairsSection');
      const noResults = document.getElementById('noResultsState');

      local.style.display = (currentTab === 'all' || currentTab === 'local') ? '' : 'none';
      online.style.display = (currentTab === 'all' || currentTab === 'online') ? '' : 'none';
      fairs.style.display = (currentTab === 'all' || currentTab === 'fairs') ? '' : 'none';

      const hasLocal = getFilteredStores().length > 0;
      const hasOnline = getFilteredOnline().length > 0;
      const hasFairs = getFilteredFairs().length > 0;
      
      let hasResults = false;
      if (currentTab === 'all') hasResults = hasLocal || hasOnline || hasFairs;
      else if (currentTab === 'local') hasResults = hasLocal;
      else if (currentTab === 'online') hasResults = hasOnline;
      else if (currentTab === 'fairs') hasResults = hasFairs;

      if (noResults) noResults.style.display = hasResults ? 'none' : 'flex';
    }

    function updateResultsCounts() {
      const ls = getFilteredStores().length;
      const op = getFilteredOnline().length;
      const fs = getFilteredFairs().length;
      const el1 = document.getElementById('localResultsCount');
      const el2 = document.getElementById('onlineResultsCount');
      const el3 = document.getElementById('fairsResultsCount');
      if (el1) el1.textContent = `${ls} store${ls!==1?'s':''} found`;
      if (el2) el2.textContent = `${op} platform${op!==1?'s':''}`;
      if (el3) el3.textContent = `${fs} event${fs!==1?'s':''}`;
    }

    function resetAllFilters() {
      const in1 = document.getElementById('marketKeywordInput');
      const in2 = document.getElementById('globalMarketSearch');
      if (in1) in1.value = '';
      if (in2) in2.value = '';
      const radSelect = document.getElementById('radiusSelect');
      if (radSelect) radSelect.value = '25';
      currentRadius = 25;
      currentTab = 'all';
      document.querySelectorAll(".cc-tab-pill").forEach(el => el.classList.remove("active"));
      const allTab = document.querySelector('[data-tab="all"]');
      if (allTab) allTab.classList.add("active");
      filterAllContent();
      drawRadiusCircle();
      if (mapInstance) mapInstance.setZoom(13);
    }

    // ==================== INTERACTION HANDLERS ====================
    function handleGlobalSearch(value) {
      const in1 = document.getElementById('marketKeywordInput');
      if (in1) in1.value = value;
      filterAllContent();
    }

    function promptChangeLocation() {
      openCityModal();
    }

    function toggleFilterDrawer() {
      openCityModal();
    }

    // Mobile sidebar drawer controller
    function toggleCcSidebar(show) {
      const sidebar = document.getElementById('appSidebar');
      const backdrop = document.getElementById('ccSidebarBackdrop');
      if (sidebar) sidebar.classList.toggle('open', show);
      if (backdrop) backdrop.classList.toggle('open', show);
      document.body.style.overflow = show ? 'hidden' : '';
    }

