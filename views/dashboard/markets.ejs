            <span>💰 Commission:</span>
            <strong>${p.commission}</strong>
          </div>
          <div class="cc-platform-benefits">
            ${p.benefits.map(b => `<span class="cc-benefit-item">✓ ${b}</span>`).join('')}
          </div>
          <div class="cc-platform-actions">
            <a href="${p.link}" target="_blank" rel="noopener noreferrer" class="cc-btn-onboard">
              Start Onboarding ↗
            </a>
            <button type="button" class="cc-btn-learn" onclick="openPlatformGuide('${p.id}')">
              📋 Requirements Checklist
            </button>
          </div>
