        <div class="cc-platform-card">
          <div class="cc-platform-header">
            <div class="cc-platform-icon">${p.icon}</div>
            <div class="cc-platform-title-group">
              <h4>${p.name}</h4>
              <span class="cc-platform-sellers">${p.sellers}</span>
            </div>
            <span class="cc-platform-badge" style="background:${p.badgeColor}15; color:${p.badgeColor}; border:1px solid ${p.badgeColor}30">${p.badge}</span>
          </div>
          <p class="cc-platform-desc">${p.description}</p>
          <div class="cc-platform-tags">
            ${p.tags.map(t => `<span class="cc-tag-pill">${t}</span>`).join('')}
          </div>
