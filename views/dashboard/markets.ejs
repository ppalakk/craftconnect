    // Recalculate distances for all stores and fairs relative to currentCenter
    function recalculateDistances() {
      allStores.forEach(s => {
        s.distance = haversineDistance(currentCenter[0], currentCenter[1], s.lat, s.lng);
      });
      allStores.sort((a, b) => a.distance - b.distance);

      fairsData.forEach(f => {
        f.distance = haversineDistance(currentCenter[0], currentCenter[1], f.lat, f.lng);
      });
      fairsData.sort((a, b) => a.distance - b.distance);
    }

    // ==================== INITIALIZATION ====================
    document.addEventListener("DOMContentLoaded", function () {
      recalculateDistances();
      updateLocationDisplayLabels();
      initMap();
      renderLocalStores();
      renderOnlinePlatforms();
      renderFairs();
      updateResultsCounts();

      // Window resize map fix
      window.addEventListener('resize', () => {
