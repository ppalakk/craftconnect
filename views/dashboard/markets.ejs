    }

    function showNotifications() {
      const panel = document.getElementById('notifPanel');
      if (panel) panel.style.display = panel.style.display === 'none' ? 'flex' : 'none';
    }

    function cycleLang() {
      const langs = ['English', 'हिन्दी', 'मराठी', 'ગુજરાતી'];
      const label = document.getElementById('langLabel');
      if (label) {
        const idx = langs.indexOf(label.textContent);
        label.textContent = langs[(idx + 1) % langs.length];
      }
    }

    function triggerAskAI() {
      alert("✨ CraftConnect AI Assistant:\n\nHello! I can help you:\n• Find nearby craft stores for your products\n• Calculate consignment margins\n• Apply for upcoming fairs like SARAS Mela\n• Connect with online platforms like Amazon Karigar & ONDC\n\nHow can I help you today?");
    }
  </script>
