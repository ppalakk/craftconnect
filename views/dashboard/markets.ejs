<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Markets & Discovery - CraftConnect</title>
  <meta name="description" content="Find local craft markets, online selling platforms, and upcoming artisan fairs near you. CraftConnect smart market linkage for Indian artisans.">
  <link rel="manifest" href="/public/manifest.json">
  <meta name="theme-color" content="#04332D">
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <!-- Styles -->
  <link rel="stylesheet" href="/public/css/style.css">
  <link rel="stylesheet" href="/public/css/sidebar.css">
  <link rel="stylesheet" href="/public/css/market-discovery.css">
  <script>
    window.CC_USER = <%- JSON.stringify(typeof user !== 'undefined' && user ? user : null) %>;
  </script>
</head>
<body style="margin: 0; padding: 0; background-color: #F8FAF9; font-family: 'Outfit', 'Inter', sans-serif;">

  <div class="cc-app-layout">
    <!-- Backdrop overlay for mobile drawer -->
    <div id="ccSidebarBackdrop" class="cc-sidebar-backdrop" onclick="toggleCcSidebar(false)"></div>

    <!-- ================= LEFT PERSISTENT SIDEBAR ================= -->
    <aside class="cc-sidebar" id="appSidebar">
      <!-- Brand Header -->
      <div class="cc-sidebar-brand">
        <div class="cc-brand-logo">
          <svg width="34" height="34" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 3C9.71573 3 3 9.71573 3 18C3 26.2843 9.71573 33 18 33C26.2843 33 33 26.2843 33 18C33 9.71573 26.2843 3 18 3Z" fill="#0C453C"/>
            <path d="M11 25C13.5 19 18 13 25 10C24 18 19 23.5 13 25L11 25Z" fill="#84CC16"/>
            <path d="M14 23C16.5 19.5 20.5 15.5 24.5 13.5C23.5 18 19.5 21.5 15 23L14 23Z" fill="#A3E635"/>
            <path d="M12 25C14.5 24 19 20 22 15" stroke="#04332D" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </div>
        <div style="flex:1;">
          <h1 class="cc-brand-title">CraftConnect</h1>
          <span class="cc-brand-subtitle">Empowering Artisans</span>
        </div>
        <button type="button" class="cc-sidebar-close-btn" onclick="toggleCcSidebar(false)" title="Close menu" aria-label="Close menu">&times;</button>
      </div>

      <!-- Navigation Menu -->
      <ul class="cc-sidebar-nav">
        <li>
          <a href="/dashboard#home" class="cc-nav-item">
            <span class="cc-nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            </span>
            <span>Home</span>
          </a>
        </li>
        <li>
          <a href="/catalog" class="cc-nav-item">
            <span class="cc-nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path><path d="M6 6h10"></path><path d="M6 10h10"></path></svg>
            </span>
            <span>Catalog</span>
          </a>
        </li>
        <li>
          <a href="/ai-scan" class="cc-nav-item">
            <span class="cc-nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </span>
            <span>AI Scan</span>
          </a>
        </li>
        <li>
          <a href="/markets" class="cc-nav-item active">
            <span class="cc-nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path><path d="M2 7h20"></path></svg>
            </span>
            <span>Markets</span>
            <span class="cc-nav-dot"></span>
          </a>
        </li>
        <li>
          <a href="/dashboard#orders" class="cc-nav-item">
            <span class="cc-nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"></rect><line x1="2" x2="22" y1="10" y2="10"></line></svg>
            </span>
            <span>Pending Orders</span>
            <span class="cc-nav-badge-orange">2</span>
          </a>
        </li>
        <li>
          <a href="/dashboard#insights" class="cc-nav-item">
            <span class="cc-nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="18" y1="20" y2="10"></line><line x1="12" x2="12" y1="20" y2="4"></line><line x1="6" x2="6" y1="20" y2="14"></line></svg>
            </span>
            <span>Demand Insights</span>
          </a>
        </li>
        <li>
          <a href="/dashboard#profile" class="cc-nav-item">
            <span class="cc-nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </span>
            <span>Profile</span>
          </a>
        </li>
      </ul>

      <!-- Section: GROW & SOURCE -->
      <p class="cc-sidebar-section-title">Grow &amp; Source</p>
      <ul class="cc-sidebar-nav">
        <li>
          <a href="/dashboard#materials" class="cc-nav-item">
            <span class="cc-nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10c0-4.42-3-8-8-9.5"></path><path d="M8.5 8.5C9 12 12 15 15.5 15.5"></path></svg>
            </span>
            <span>Raw Materials</span>
          </a>
        </li>
        <li>
          <a href="/dashboard#schemes" class="cc-nav-item">
            <span class="cc-nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="M5 21V7l7-4 7 4v14"></path><path d="M9 10h6"></path><path d="M9 14h6"></path><path d="M9 18h6"></path></svg>
            </span>
            <span>Govt Schemes</span>
          </a>
        </li>
      </ul>

      <!-- Footer Actions -->
      <div class="cc-sidebar-footer-group">
        <a href="/logout" class="cc-logout-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" x2="9" y1="12" y2="12"></line></svg>
          <span>Logout</span>
        </a>

        <div class="cc-sidebar-mini-card">
          <div style="font-size: 20px;">🌿</div>
          <div class="cc-mini-card-text">
            <strong>CraftConnect</strong>
            <span>Connecting Artisans • Growing Markets</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- ================= MAIN CONTENT WRAPPER ================= -->
    <div class="cc-main-container">
      <!-- Top Header Bar -->
      <header class="cc-topbar">
        <!-- Mobile Hamburger -->
        <button type="button" class="cc-mobile-menu-btn" onclick="toggleCcSidebar(true)" title="Open Menu" aria-label="Open Navigation Menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <!-- Search Input -->
        <div class="cc-topbar-search-wrap">
          <span class="cc-topbar-search-icon">🔍</span>
          <input type="text" class="cc-topbar-search-input" placeholder="Search markets, exhibitions, products, or locations..." id="globalMarketSearch" oninput="handleGlobalSearch(this.value)">
        </div>

        <!-- Right Action Items -->
        <div class="cc-topbar-actions">
          <!-- Notification Bell -->
          <button type="button" class="cc-topbar-bell-btn" title="Notifications" onclick="showNotifications()">
            🔔
            <span class="cc-bell-dot"></span>
          </button>

          <!-- Language Selector -->
          <div class="cc-lang-pill" onclick="cycleLang()">
            <span>🌐</span>
            <span id="langLabel">English</span>
            <span style="font-size: 10px; color: #64748B;">▾</span>
          </div>

          <!-- User Profile -->
          <div class="cc-user-chip" onclick="location.href='/dashboard#profile'">
            <% if (typeof user !== 'undefined' && user && user.avatar) { %>
              <img src="<%= user.avatar %>" alt="User Avatar" class="cc-user-avatar" onerror="this.src='/images/default_avatar.png'">
            <% } else if (typeof user !== 'undefined' && user && user.name) { %>
              <div class="cc-user-avatar" style="background:#0F5147; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px; border-radius:50%; width:36px; height:36px; flex-shrink:0;">
                <%= user.name.split(' ').map(w => w[0]).join('').toUpperCase().slice(0, 2) %>
              </div>
            <% } else { %>
              <img src="/images/default_avatar.png" alt="Guest" class="cc-user-avatar">
            <% } %>
            <div class="cc-user-details">
              <span class="cc-user-name"><%= (typeof user !== 'undefined' && user && user.name) ? user.name : 'Guest Artisan' %></span>
              <span class="cc-user-role"><%= (typeof user !== 'undefined' && user && user.role) ? user.role.toUpperCase() : 'ARTISAN' %></span>
            </div>
          </div>
        </div>
      </header>

      <!-- Content Area -->
      <main class="cc-content-view">
        <!-- ================= 1. HERO BANNER: SMART MARKET LINKAGE ================= -->
        <section class="cc-hero-card">
          <div class="cc-hero-left">
            <div class="cc-hero-badge">
              <span>📍</span>
              <span>Smart Market Linkage</span>
            </div>
            <h2 class="cc-hero-title">
              Find the Right Markets
              <span class="highlight-orange">for Your Crafts</span>
            </h2>
            <p class="cc-hero-desc">
              Get local market suggestions based on your location, and connect with trusted online platforms like Amazon, Flipkart, Meesho, Myntra &amp; more.
            </p>
            <div class="cc-hero-pills-row">
              <button type="button" class="cc-hero-pill-btn" onclick="selectTab('local', document.querySelector('[data-tab=local]'))">
                <span>🏪</span>
                <span>Local Markets</span>
              </button>
              <button type="button" class="cc-hero-pill-btn" onclick="selectTab('online', document.querySelector('[data-tab=online]'))">
                <span>🛒</span>
                <span>Online Platforms</span>
              </button>
              <button type="button" class="cc-hero-pill-btn" onclick="selectTab('fairs', document.querySelector('[data-tab=fairs]'))">
                <span>🎪</span>
                <span>Fairs & Expos</span>
              </button>
              <button type="button" class="cc-hero-pill-btn" onclick="selectTab('all', document.querySelector('[data-tab=all]'))">
                <span>📈</span>
                <span>View All</span>
              </button>
            </div>
          </div>

          <div class="cc-hero-right">
            <div class="cc-hero-doodle-wrap">
              <span>Your Craft</span>
              <span>Our Support</span>
              <div class="cc-hero-doodle-arrow">♡ ➔</div>
            </div>
            <div class="cc-hero-photo-wrap">
              <img src="/images/hero_crafts.jpg" alt="Traditional Indian Crafts" class="cc-hero-photo" onerror="this.src='https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?auto=format&fit=crop&w=900&q=80'">
            </div>
          </div>
        </section>

        <!-- ================= 2. LOCATION & SEARCH BAR CARD ================= -->
        <div class="cc-loc-search-card">
          <div class="cc-loc-info-group">
            <div class="cc-loc-pin-icon">📍</div>
            <div>
              <span class="cc-loc-label">Your Current Location</span>
              <div class="cc-loc-value-row">
                <span class="cc-loc-name" id="currentLocationName">Bhopal, Madhya Pradesh</span>
                <button type="button" class="cc-loc-change-link" onclick="openCityModal()" title="Change city">
                  <span>🔄</span>
                  <span>Change</span>
                </button>
                <button type="button" class="cc-loc-gps-btn" id="btnUseGps" onclick="requestGpsLocation()" title="Use live GPS coordinates">
                  <span>📡</span>
                  <span id="gpsBtnText">Use GPS</span>
                </button>
              </div>
            </div>
          </div>

          <div class="cc-loc-search-box">
            <span style="color: #94A3B8;">🔍</span>
            <input type="text" placeholder="Search markets, platforms or product types..." id="marketKeywordInput" oninput="filterAllContent()">
            <button type="button" class="cc-loc-filter-slider-btn" title="Filter Options" onclick="toggleFilterDrawer()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="21" y2="21"></line><line x1="4" x2="20" y1="14" y2="14"></line><line x1="4" x2="20" y1="7" y2="7"></line><circle cx="8" cy="21" r="2"></circle><circle cx="16" cy="14" r="2"></circle><circle cx="10" cy="7" r="2"></circle></svg>
            </button>
          </div>
        </div>

        <!-- ================= 3. FILTER TABS & DISTANCE DROPDOWN ================= -->
        <div class="cc-filter-tabs-bar">
          <div class="cc-tab-pills-group">
            <button type="button" class="cc-tab-pill active" data-tab="all" onclick="selectTab('all', this)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg>
              <span>All Markets</span>
            </button>
            <button type="button" class="cc-tab-pill" data-tab="local" onclick="selectTab('local', this)">
              <span>🏪</span>
              <span>Local Markets</span>
            </button>
            <button type="button" class="cc-tab-pill" data-tab="online" onclick="selectTab('online', this)">
              <span>🛒</span>
              <span>Online Platforms</span>
            </button>
            <button type="button" class="cc-tab-pill" data-tab="fairs" onclick="selectTab('fairs', this)">
              <span>🎪</span>
              <span>Fairs &amp; Exhibitions</span>
            </button>
          </div>

          <div class="cc-distance-dropdown-wrap">
            <select id="radiusSelect" class="cc-radius-select" onchange="updateRadius(this.value)">
              <option value="10">📍 Within 10 km</option>
              <option value="25" selected>📍 Within 25 km</option>
              <option value="50">📍 Within 50 km</option>
            </select>
          </div>
        </div>

        <!-- ================= 4. MIDDLE TWO-COLUMN GRID: STORES & MAP ================= -->
        <div class="cc-middle-grid" id="localSection">
          <!-- Left Column: Local Stores Near You -->
          <div class="cc-stores-column" id="localStoresSection">
            <div class="cc-section-header-row">
              <div class="cc-section-title-wrap">
                <h3><span>📍</span> Local Stores Near You</h3>
                <p>Handpicked stores and boutiques in your area that sell handmade and craft products.</p>
              </div>
              <span class="cc-results-count" id="localResultsCount">6 stores found</span>
            </div>

            <!-- Stores Grid -->
            <div class="cc-stores-grid" id="storesContainer">
              <!-- Cards rendered by JS -->
            </div>
          </div>

          <!-- Right Column: Interactive Map Card -->
          <div class="cc-map-column">
            <div class="cc-map-header">
              <div class="cc-map-loc-info">
                <strong>📍 Your Location</strong>
                <span id="mapLocLabel">Bhopal, Madhya Pradesh</span>
              </div>
              <a href="https://www.google.com/maps/search/craft+stores+near+Bhopal+Madhya+Pradesh" target="_blank" rel="noopener noreferrer" class="cc-map-view-large">
                View Larger Map →
              </a>
            </div>

            <!-- Map Viewport -->
            <div class="cc-map-wrapper">
              <div id="bhopalArtisanMap"></div>

              <!-- Overlay Controls -->
              <div class="cc-map-controls-overlay">
                <button type="button" class="cc-map-btn" onclick="zoomMap(1)" title="Zoom In">+</button>
                <button type="button" class="cc-map-btn" onclick="zoomMap(-1)" title="Zoom Out">−</button>
                <button type="button" class="cc-map-btn" onclick="recenterMap()" title="Center My Location">🎯</button>
              </div>
            </div>

            <!-- Map Legend Strip -->
            <div class="cc-map-legend-strip">
              <div class="cc-legend-item">
                <span class="cc-legend-dot dot-blue"></span>
                <span>You</span>
              </div>
              <div class="cc-legend-item">
                <span class="cc-legend-dot dot-green"></span>
                <span>Local Store</span>
              </div>
              <div class="cc-legend-item">
                <span class="cc-legend-dot dot-orange"></span>
                <span>Fair / Expo</span>
              </div>
              <div class="cc-legend-item">
                <span class="cc-legend-dot dot-pink"></span>
                <span>Fulfillment Hub</span>
              </div>
            </div>
          </div>
        </div>

        <!-- ================= 5. ONLINE PLATFORMS (INLINE SECTION) ================= -->
        <section class="cc-online-section" id="onlineSection">
          <div class="cc-section-header-row">
            <div class="cc-section-title-wrap">
              <h3><span>🛒</span> Verified Online Platforms</h3>
              <p>Reach millions of buyers through verified e-commerce artisan programs with subsidized fees.</p>
            </div>
            <span class="cc-results-count" id="onlineResultsCount">5 platforms</span>
          </div>

          <div class="cc-online-grid" id="onlinePlatformsContainer">
            <!-- Rendered by JS -->
          </div>
        </section>

        <!-- ================= 6. UPCOMING FAIRS & EXHIBITIONS ================= -->
        <section class="cc-fairs-section" id="fairsSection">
          <div class="cc-section-header-row">
            <div class="cc-section-title-wrap">
              <h3><span>🎪</span> Upcoming Fairs &amp; Exhibitions</h3>
              <p>Government-verified craft fairs, bazaars and cultural festivals with direct application links.</p>
            </div>
            <span class="cc-results-count" id="fairsResultsCount">5 events</span>
          </div>

          <div class="cc-fairs-grid" id="fairsContainer">
            <!-- Rendered by JS -->
          </div>
        </section>

        <!-- ================= 7. NO RESULTS STATE ================= -->
        <div class="cc-no-results" id="noResultsState" style="display:none;">
          <div class="cc-no-results-inner">
            <span class="cc-no-results-icon">🔍</span>
            <h3>No results found</h3>
            <p>Try adjusting your search keywords or expanding the radius filter.</p>
            <button type="button" class="cc-btn-reset-filters" onclick="resetAllFilters()">Reset All Filters</button>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- ================= FLOATING ACTION BUTTON (ASK AI) ================= -->
  <button type="button" class="cc-ask-ai-fab" onclick="triggerAskAI()">
    <span>✨</span>
    <span>Ask AI</span>
  </button>

  <!-- ================= NOTIFICATION PANEL ================= -->
  <div id="notifPanel" class="cc-notif-panel" style="display:none;">
    <div class="cc-notif-card">
      <div class="cc-notif-header">
        <h4>🔔 Notifications</h4>
        <button type="button" onclick="document.getElementById('notifPanel').style.display='none'">✕</button>
      </div>
      <div class="cc-notif-body">
        <div class="cc-notif-item cc-notif-new">
          <span class="cc-notif-dot"></span>
          <div>
            <strong>SARAS Mela application closing in 7 days</strong>
            <p>Apply for a stall at Bhopal Haat before the deadline.</p>
            <span class="cc-notif-time">2 hours ago</span>
          </div>
        </div>
        <div class="cc-notif-item cc-notif-new">
          <span class="cc-notif-dot"></span>
          <div>
            <strong>2 new pending orders</strong>
            <p>Terracotta set order from Mumbai and Handloom order from Delhi.</p>
            <span class="cc-notif-time">5 hours ago</span>
          </div>
        </div>
        <div class="cc-notif-item">
          <div>
            <strong>Amazon Karigar onboarding approved</strong>
            <p>Your seller profile is now live on Amazon Karigar.</p>
            <span class="cc-notif-time">1 day ago</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= STORE DETAIL MODAL ================= -->
  <div id="storeDetailModal" class="market-modal-overlay" style="display:none;">
    <div class="market-modal-card" style="max-width: 520px;">
      <button type="button" class="market-modal-close" onclick="closeStoreModal()">✕</button>
      <div id="storeDetailContent"></div>
    </div>
  </div>

  <!-- ================= CITY / LOCATION SELECTOR MODAL ================= -->
  <div id="cityPickerModal" class="market-modal-overlay" style="display:none;">
    <div class="market-modal-card" style="max-width: 480px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
        <h3 style="font-size:17px; font-weight:700; color:#0F172A; margin:0; display:flex; align-items:center; gap:8px;">
          <span>📍</span> Select Your Location
        </h3>
        <button type="button" class="market-modal-close" onclick="closeCityModal()">✕</button>
      </div>
      <p style="font-size:13px; color:#64748B; margin:0 0 14px; line-height:1.45;">
