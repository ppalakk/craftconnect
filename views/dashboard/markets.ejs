            <h4>No stores match your filters</h4>
            <p>Try expanding the search radius (${currentRadius} km) or choose another city.</p>
            <button type="button" class="cc-btn-reset-filters" style="margin-top:10px;" onclick="updateRadius(50)">Expand to 50 km</button>
          </div>`;
        return;
      }

      container.innerHTML = stores.map(s => `
        <div class="cc-store-card" data-store-id="${s.id}" onclick="focusStoreOnMap('${s.id}')">
          <div class="cc-store-thumb-wrap">
            <img src="${s.image}" alt="${s.name}" class="cc-store-thumb" onerror="this.onerror=null; this.src='/images/hero_crafts.jpg';">
            <span class="cc-store-dist-badge">📍 ${s.distance} km</span>
          </div>
          <div class="cc-store-body">
            <h4 class="cc-store-title">${s.name}</h4>
            <div class="cc-store-tags">
              ${s.tags.map(t => `<span class="cc-tag-pill">${t}</span>`).join('')}
            </div>
            <div class="cc-store-detail-row">
              <span>📍</span>
              <span>${s.address}</span>
            </div>
            <div class="cc-store-detail-row">
              <span>🕒</span>
              <span>${s.hours}</span>
            </div>
            <div class="cc-store-rating-row">
              <span class="cc-star-icon">⭐</span>
              <span>${s.rating}</span>
              <span class="cc-reviews-count">(${s.reviews} reviews)</span>
            </div>
            <div style="display:flex; gap:8px; margin-top:8px;">
              <a href="https://www.google.com/maps/dir/?api=1&destination=${s.lat},${s.lng}" target="_blank" rel="noopener noreferrer" class="cc-btn-directions" style="flex:1;" onclick="event.stopPropagation()">
                Directions ↗
              </a>
              <button type="button" class="cc-btn-directions" style="background:#F1F5F9; color:#0F172A; border:1px solid #CBD5E1;" onclick="event.stopPropagation(); openStoreDetail('${s.id}')">
