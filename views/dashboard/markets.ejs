      });
    });

    function updateLocationDisplayLabels() {
      const full = `${currentCity}, ${currentStateName}`;
      const el1 = document.getElementById("currentLocationName");
      const el2 = document.getElementById("mapLocLabel");
      if (el1) el1.innerText = full;
      if (el2) el2.innerText = full;
    }

    // ==================== MAP INITIALIZATION ====================
    function initMap() {
      if (mapInstance) return;
      const mapElement = document.getElementById("bhopalArtisanMap");
      if (!mapElement) return;

      mapInstance = L.map("bhopalArtisanMap", {
        center: currentCenter,
        zoom: currentRadius <= 10 ? 14 : currentRadius <= 25 ? 13 : 11,
        zoomControl: false,
        attributionControl: false,
        tap: true,
        dragging: true
      });

      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        maxZoom: 19,
        subdomains: 'abcd',
        attribution: '© OpenStreetMap contributors, © CARTO'
      }).addTo(mapInstance);

      // User location marker with ripple ring
      const userIcon = L.divIcon({
        className: 'cc-user-map-marker',
        html: '<div class="cc-pulse-dot"><div class="cc-pulse-ring"></div></div>',
        iconSize: [26, 26],
        iconAnchor: [13, 13]
      });
      userMarker = L.marker(currentCenter, { icon: userIcon, zIndexOffset: 1000 })
        .addTo(mapInstance)
        .bindPopup(`<strong>📍 Your Location</strong><br><span style="font-size:12px;color:#075C55;">${currentCity}, ${currentStateName}</span>`);

      drawRadiusCircle();
      addMapMarkers();

      setTimeout(() => {
        if (mapInstance) mapInstance.invalidateSize();
      }, 250);
    }

    function drawRadiusCircle() {
      if (!mapInstance) return;
      if (radiusCircle) mapInstance.removeLayer(radiusCircle);
      radiusCircle = L.circle(currentCenter, {
        radius: currentRadius * 1000,
        color: '#075C55',
        fillColor: '#075C55',
        fillOpacity: 0.06,
        weight: 1.5,
        dashArray: '6, 5'
      }).addTo(mapInstance);
    }

    function addMapMarkers() {
      if (!mapInstance) return;
      // Remove old markers
      mapMarkers.forEach(m => mapInstance.removeLayer(m));
      mapMarkers = [];

      const stores = getFilteredStores();
      stores.forEach(s => {
        const isSelected = false;
        const icon = L.divIcon({
          className: 'custom-leaflet-marker',
          html: `<div class="cc-map-pin pin-green" id="marker-pin-${s.id}"><span class="cc-pin-pulse"></span>${s.name.length > 14 ? s.name.substring(0,14)+'…' : s.name}</div>`,
          iconSize: [120, 30],
          iconAnchor: [60, 15]
        });
        const marker = L.marker([s.lat, s.lng], { icon })
          .addTo(mapInstance)
          .bindPopup(`
            <div style="min-width:190px; padding:2px;">
              <strong style="font-size:13.5px; color:#0F172A; display:block; margin-bottom:2px;">${s.name}</strong>
              <span style="font-size:11.5px; color:#64748B; display:block; margin-bottom:4px;">${s.address}</span>
              <span style="font-size:11.5px; color:#075C55; font-weight:700;">⭐ ${s.rating} (${s.reviews} reviews) • 📍 ${s.distance} km</span><br>
              <div style="display:flex; gap:6px; margin-top:8px;">
                <a href="https://www.google.com/maps/dir/?api=1&destination=${s.lat},${s.lng}" target="_blank" rel="noopener noreferrer" style="flex:1; text-align:center; padding:5px 8px; background:#075C55; color:#fff; border-radius:8px; font-size:11px; font-weight:600; text-decoration:none;">Directions ↗</a>
