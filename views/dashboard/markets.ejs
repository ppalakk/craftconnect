              <span style="font-size:11px; color:#64748B;">📅 ${f.dates}</span><br>
              <span style="font-size:11.5px; color:#059669; font-weight:700;">${f.status} • ${f.daysLeft}d left</span><br>
              <a href="${f.applyLink}" target="_blank" rel="noopener noreferrer" style="display:inline-block; margin-top:6px; padding:4px 10px; background:#D97706; color:#fff; border-radius:8px; font-size:11px; font-weight:600; text-decoration:none;">Apply Now ↗</a>
            </div>
          `);
        mapMarkers.push(marker);
      });
    }

    function zoomMap(delta) {
      if (mapInstance) mapInstance.setZoom(mapInstance.getZoom() + delta);
    }

    function recenterMap() {
      if (mapInstance) {
        mapInstance.flyTo(currentCenter, currentRadius <= 10 ? 14 : currentRadius <= 25 ? 13 : 11, { duration: 0.8 });
        if (userMarker) userMarker.openPopup();
      }
    }

    // Smooth focus from card to map
    function focusStoreOnMap(storeId) {
      const store = allStores.find(s => s.id === storeId);
      if (!store || !mapInstance) return;

      // Update card visual active state
      document.querySelectorAll('.cc-store-card').forEach(c => c.classList.remove('selected-on-map'));
      const card = document.querySelector(`[data-store-id="${storeId}"]`);
      if (card) card.classList.add('selected-on-map');

      // Fly to store on map
      mapInstance.flyTo([store.lat, store.lng], 15, { duration: 0.8 });

      // Open popup
      const matchingMarker = mapMarkers.find(m => m.storeId === storeId);
      if (matchingMarker) {
        setTimeout(() => matchingMarker.openPopup(), 400);
      }

      // On mobile screens, scroll smoothly towards the map so it is visible
      if (window.innerWidth < 1024) {
        const mapCol = document.querySelector('.cc-map-column');
        if (mapCol) {
          mapCol.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    }

    // ==================== GEOLOCATION SYSTEM ====================
    function requestGpsLocation() {
      const btn = document.getElementById("btnUseGps");
      const label = document.getElementById("gpsBtnText");
      if (label) label.textContent = "Locating...";

      if (!navigator.geolocation) {
        alert("Geolocation is not supported by your browser. Please enter your city manually.");
        if (label) label.textContent = "Use GPS";
        return;
      }

      navigator.geolocation.getCurrentPosition(
        async (position) => {
          const lat = position.coords.latitude;
          const lng = position.coords.longitude;
          currentCenter = [lat, lng];

          try {
            const res = await fetch(`/api/markets/geocode?lat=${lat}&lng=${lng}`);
            const data = await res.json();
            if (data.ok && data.city) {
              currentCity = data.city;
              currentStateName = data.state || "India";
            } else {
              currentCity = "My Location";
              currentStateName = "GPS Coordinates";
            }
          } catch (e) {
            currentCity = "My Location";
            currentStateName = "GPS Coordinates";
          }

          updateLocationDisplayLabels();
          recalculateDistances();
          drawRadiusCircle();
          addMapMarkers();
          recenterMap();
          filterAllContent();

          if (userMarker) {
            userMarker.setLatLng(currentCenter).bindPopup(`<strong>📍 Your Live Location</strong><br><span style="font-size:12px;color:#075C55;">${currentCity}, ${currentStateName}</span>`).openPopup();
          }

          if (btn) btn.classList.add("active");
          if (label) label.textContent = "✓ GPS Active";
        },
        (err) => {
          console.warn("GPS detection error:", err);
          if (label) label.textContent = "Use GPS";
          alert("Location permission was denied or timed out. Please enter your city manually in the search dialog.");
          openCityModal();
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    }

    function openCityModal() {
      const modal = document.getElementById("cityPickerModal");
      if (modal) modal.style.display = "flex";
      const inp = document.getElementById("citySearchInput");
      if (inp) {
        inp.value = "";
        setTimeout(() => inp.focus(), 100);
      }
    }

    function closeCityModal() {
      const modal = document.getElementById("cityPickerModal");
      if (modal) modal.style.display = "none";
    }

    async function applySearchedCity() {
      const inp = document.getElementById("citySearchInput");
      const query = inp ? inp.value.trim() : "";
      if (!query) return;

      try {
        const res = await fetch(`/api/markets/geocode?query=${encodeURIComponent(query)}`);
        const data = await res.json();
        if (data.ok && data.lat && data.lng) {
          chooseCityPreset(data.city || query, data.state || "India", data.lat, data.lng);
        } else {
          alert(data.error || "City not found in India. Please check spelling.");
        }
      } catch (e) {
        alert("Network error searching city. Please try again.");
      }
    }

    function chooseCityPreset(city, state, lat, lng) {
      currentCity = city;
      currentStateName = state;
      currentCenter = [lat, lng];

      updateLocationDisplayLabels();
      recalculateDistances();
      drawRadiusCircle();
      addMapMarkers();
      recenterMap();
      filterAllContent();

      if (userMarker) {
        userMarker.setLatLng(currentCenter).bindPopup(`<strong>📍 ${city}</strong><br><span style="font-size:12px;color:#075C55;">${state}</span>`).openPopup();
      }

      const btn = document.getElementById("btnUseGps");
      const label = document.getElementById("gpsBtnText");
      if (btn) btn.classList.remove("active");
      if (label) label.textContent = "Use GPS";

      closeCityModal();
    }

    // ==================== RENDER FUNCTIONS ====================
    function renderLocalStores() {
