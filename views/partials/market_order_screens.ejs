    <!-- SPA Map Initialization Trigger -->
    <script>
        window.initSpaMap = function() {
            if (window.spaMap) {
                window.spaMap.invalidateSize();
                return;
            }
            const mapEl = document.getElementById("spaArtisanMap");
            if (!mapEl || typeof L === 'undefined') return;

            window.spaMap = L.map("spaArtisanMap", {
                center: [23.2599, 77.4126],
                zoom: 13,
                zoomControl: false,
                attributionControl: false
            });

            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                maxZoom: 19,
                subdomains: 'abcd'
            }).addTo(window.spaMap);

            const spaMarkers = [
                { lat: 23.2620, lng: 77.3950, label: "Local Market", type: "pin-green" },
                { lat: 23.2350, lng: 77.4320, label: "Craft Bazaar", type: "pin-orange" },
                { lat: 23.2512, lng: 77.4421, label: "The Artisan Hub", type: "pin-orange" },
                { lat: 23.2420, lng: 77.4180, label: "Online Platform", type: "pin-pink" }
            ];

            spaMarkers.forEach(m => {
                const icon = L.divIcon({
                    className: 'custom-leaflet-marker',
                    html: `<div class="cc-map-pin ${m.type}">${m.label}</div>`,
                    iconSize: [80, 24],
                    iconAnchor: [40, 12]
                });
                L.marker([m.lat, m.lng], { icon }).addTo(window.spaMap);
            });
        };

        // When user navigates to markets screen in SPA
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(window.initSpaMap, 500);
        });
        window.addEventListener('hashchange', function() {
            if (window.location.hash === '#markets') {
                setTimeout(window.initSpaMap, 200);
            }
        });
    </script>
</section>

