<!-- ================= MARKETS: SMART MARKET LINKAGE & DISCOVERY PLATFORM ================= -->
<section class="screen" id="markets">
    <div style="padding: 10px 0 30px;">
        <!-- ================= 1. HERO BANNER: SMART MARKET LINKAGE ================= -->
        <section class="cc-hero-card">
          <div class="cc-hero-left">
            <div class="cc-hero-badge">
              <span>📍</span>
              <span>Smart Market Linkage</span>
            </div>
            <h2 class="cc-hero-title">
              Find the Right Markets
              <span class="highlight-orange">for Your Crafts</span>
            </h2>
            <p class="cc-hero-desc">
              Get local market suggestions based on your location, and connect with trusted online platforms like Amazon, Flipkart, Meesho, Myntra &amp; more.
            </p>
            <div class="cc-hero-pills-row">
              <button type="button" class="cc-hero-pill-btn" onclick="document.getElementById('spaStoresSection').scrollIntoView({behavior:'smooth',block:'start'})">
                <span>🏪</span>
                <span>Local Markets</span>
              </button>
              <button type="button" class="cc-hero-pill-btn" onclick="document.getElementById('spaDigitalSection').scrollIntoView({behavior:'smooth',block:'start'})">
                <span>🛒</span>
                <span>Online Platforms</span>
              </button>
              <button type="button" class="cc-hero-pill-btn" onclick="alert('Filtered by best profit margin & wholesale pricing')">
                <span>🏷️</span>
                <span>Better Prices</span>
              </button>
              <button type="button" class="cc-hero-pill-btn" onclick="document.getElementById('spaFairsSection').scrollIntoView({behavior:'smooth'})">
                <span>📈</span>
                <span>Bigger Reach</span>
              </button>
            </div>
          </div>

          <div class="cc-hero-right">
            <div class="cc-hero-doodle-wrap">
              <span>Your Craft</span>
              <span>Our Support</span>
              <div class="cc-hero-doodle-arrow">♡ ➔</div>
            </div>
            <div class="cc-hero-photo-wrap">
              <img src="/images/hero_crafts.jpg" alt="Traditional Indian Crafts" class="cc-hero-photo" onerror="this.src='/images/artisan.png'">
            </div>
          </div>
        </section>

        <!-- ================= 2. LOCATION & SEARCH BAR CARD ================= -->
        <div class="cc-loc-search-card">
          <div class="cc-loc-info-group">
            <div class="cc-loc-pin-icon">📍</div>
            <div>
              <span class="cc-loc-label">Your Current Location</span>
              <div class="cc-loc-value-row">
                <span class="cc-loc-name" id="spaLocDisplay">Bhopal, Madhya Pradesh</span>
                <button type="button" class="cc-loc-change-link" onclick="openCityModal()">
                  <span>🔄</span>
                  <span>Change</span>
                </button>
              </div>
            </div>
          </div>

          <div class="cc-loc-search-box">
            <span style="color: #94A3B8;">🔍</span>
            <input type="text" placeholder="Search markets, platforms or product types..." id="spaMarketKeywordInput" oninput="CraftMarketDiscovery.filterStores(this.value)" onkeyup="if(event.key==='Enter')CraftMarketDiscovery.searchKeyword(this.value)">
            <button type="button" class="cc-loc-filter-slider-btn" title="Filter Options" onclick="openCityModal()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="21" y2="21"></line><line x1="4" x2="20" y1="14" y2="14"></line><line x1="4" x2="20" y1="7" y2="7"></line><circle cx="8" cy="21" r="2"></circle><circle cx="16" cy="14" r="2"></circle><circle cx="10" cy="7" r="2"></circle></svg>
            </button>
          </div>
        </div>

        <!-- ================= 3. FILTER TABS & DISTANCE DROPDOWN ================= -->
        <div class="cc-filter-tabs-bar">
          <div class="cc-tab-pills-group">
            <button type="button" class="cc-tab-pill active" onclick="CraftMarketDiscovery.switchTab('all'); this.parentElement.querySelectorAll('.cc-tab-pill').forEach(b => b.classList.remove('active')); this.classList.add('active');">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg>
              <span>All Markets</span>
            </button>
            <button type="button" class="cc-tab-pill" onclick="CraftMarketDiscovery.switchTab('local'); this.parentElement.querySelectorAll('.cc-tab-pill').forEach(b => b.classList.remove('active')); this.classList.add('active');">
              <span>🏪</span>
              <span>Local Markets</span>
            </button>
            <button type="button" class="cc-tab-pill" onclick="CraftMarketDiscovery.switchTab('digital'); document.getElementById('spaDigitalSection').scrollIntoView({behavior:'smooth',block:'start'}); this.parentElement.querySelectorAll('.cc-tab-pill').forEach(b => b.classList.remove('active')); this.classList.add('active');">
              <span>🛒</span>
              <span>Online Platforms</span>
            </button>
            <button type="button" class="cc-tab-pill" onclick="CraftMarketDiscovery.switchTab('events'); this.parentElement.querySelectorAll('.cc-tab-pill').forEach(b => b.classList.remove('active')); this.classList.add('active');">
              <span>🎪</span>
              <span>Fairs &amp; Exhibitions</span>
            </button>
          </div>

          <div class="cc-distance-dropdown-wrap">
            <select id="spaRadiusSelect" class="cc-radius-select" onchange="CraftMarketDiscovery.setRadius(this.value)">
              <option value="5">📍 Within 5 km</option>
              <option value="10">📍 Within 10 km</option>
              <option value="25" selected>📍 Within 25 km</option>
              <option value="50">📍 Within 50 km</option>
              <option value="100">📍 Within 100 km</option>
            </select>
          </div>
        </div>

        <!-- ================= 4. MIDDLE TWO-COLUMN GRID: STORES & MAP ================= -->
        <div class="cc-middle-grid" id="spaStoresSection">
          <!-- Left Column: Local Stores Near You -->
          <div class="cc-stores-column">
            <div class="cc-section-header-row">
              <div class="cc-section-title-wrap">
                <h3><span>📍</span> Local Stores Near You</h3>
                <p>Handpicked stores and boutiques in your area that sell handmade and craft products.</p>
              </div>
              <span id="spaLocalCount" style="font-size: 12.5px; font-weight: 600; color: #075C55;">Searching nearby...</span>
            </div>

            <!-- Stores Horizontal Row / Carousel -->
            <div class="cc-stores-carousel-container" id="spaStoresContainer">
              <div class="cc-store-card" style="opacity: 0.7;">
                <div class="cc-store-thumb-wrap" style="background:#E2E8F0; min-height:140px; display:flex; align-items:center; justify-content:center;">
                  <span style="font-size:28px;">🏪</span>
                </div>
                <div class="cc-store-body">
                  <h4 class="cc-store-title">Discovering craft stores...</h4>
                  <p style="font-size:12px; color:#64748B;">Searching nearby artisan retail opportunities in your area.</p>
                </div>
              </div>
            </div><!-- /#spaStoresContainer -->
          </div><!-- /.cc-stores-column -->
        </div><!-- /.cc-middle-grid -->

        <!-- DIGITAL MARKETS: independent section, not a local-store card -->
        <section class="cc-digital-section" id="spaDigitalSection">
          <div class="cc-section-header-row">
            <div class="cc-section-title-wrap">
              <span class="cc-section-kicker">SELL ONLINE</span>
              <h3><span aria-hidden="true">🌐</span> Digital Marketplaces</h3>
              <p>Compare online channels and explore the official seller portals for your handmade products.</p>
            </div>
            <span class="cc-digital-count">5 platforms to explore</span>
          </div>
          <div class="cc-digital-intro">
            <div class="cc-digital-intro-icon" aria-hidden="true">✦</div>
            <div>
              <h4>Take Your Crafts Beyond Your City</h4>
              <p>Choose a platform to learn about its selling options. Seller eligibility and fees may vary.</p>
            </div>
          </div>
          <div class="cc-digital-grid">
            <a href="https://sell.amazon.in/" class="cc-digital-platform" target="_blank" rel="noopener noreferrer" aria-label="Explore selling on Amazon India">
              <span class="cc-digital-brand cc-brand-amazon">a</span><span class="cc-digital-copy"><strong>Amazon</strong><small>Seller registration</small></span><span class="cc-digital-arrow" aria-hidden="true">↗</span>
            </a>
            <a href="https://seller.flipkart.com/" class="cc-digital-platform" target="_blank" rel="noopener noreferrer" aria-label="Explore selling on Flipkart">
              <span class="cc-digital-brand cc-brand-flipkart">F</span><span class="cc-digital-copy"><strong>Flipkart</strong><small>Seller hub</small></span><span class="cc-digital-arrow" aria-hidden="true">↗</span>
            </a>
            <a href="https://supplier.meesho.com/" class="cc-digital-platform" target="_blank" rel="noopener noreferrer" aria-label="Explore selling on Meesho">
              <span class="cc-digital-brand cc-brand-meesho">M</span><span class="cc-digital-copy"><strong>Meesho</strong><small>Supplier portal</small></span><span class="cc-digital-arrow" aria-hidden="true">↗</span>
            </a>
            <a href="https://www.myntra.com/" class="cc-digital-platform" target="_blank" rel="noopener noreferrer" aria-label="Explore Myntra">
              <span class="cc-digital-brand cc-brand-myntra">M</span><span class="cc-digital-copy"><strong>Myntra</strong><small>Explore the platform</small></span><span class="cc-digital-arrow" aria-hidden="true">↗</span>
            </a>
            <a href="https://ondc.org/participants/" class="cc-digital-platform" target="_blank" rel="noopener noreferrer" aria-label="Explore ONDC Seller Network Participants">
              <span class="cc-digital-brand" style="background:#0F5147; color:#fff; font-weight:700;">O</span><span class="cc-digital-copy"><strong>ONDC</strong><small>Seller Network</small></span><span class="cc-digital-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="cc-digital-footer"><span>ⓘ</span> Check each platform’s current requirements before registering as a seller.</div>
        </section>

        <!-- ================= 5. BOTTOM SECTION: UPCOMING FAIRS & EXHIBITIONS ================= -->
        <section class="cc-fairs-section" id="spaFairsSection">
          <div class="cc-section-header-row">
            <div class="cc-section-title-wrap">
              <h3><span>🎪</span> Upcoming Fairs &amp; Exhibitions</h3>
              <p>Government-verified craft fairs, bazaars and cultural festivals with direct application links.</p>
            </div>
            <a href="#" class="cc-view-all-link" onclick="CraftMarketDiscovery.switchTab('events'); return false;">View All →</a>
          </div>

          <div class="cc-fairs-grid">
            <!-- Exhibition Card 1 -->
            <div class="cc-fair-card">
              <img src="/images/fair_saras.jpg" alt="SARAS Regional Aajeevika Craft Mela" class="cc-fair-thumb">
              <div class="cc-fair-info">
                <div class="cc-fair-badges-row">
                  <span class="cc-fair-status-pill cc-status-open">Application Open (7d left)</span>
                  <span class="cc-fair-dist-pill">📍 4.1 km</span>
                </div>
                <h4 class="cc-fair-title" title="SARAS Regional Aajeevika Craft Mela">SARAS Regional Aajeevika Craft Mela</h4>
                <div class="cc-fair-meta-row">
                  <span class="cc-fair-meta-item">📅 14 Nov 2026 – 25 Nov 2026</span>
                  <span class="cc-fair-meta-item">📍 Bhopal Haat</span>
                </div>
              </div>
            </div>

            <!-- Exhibition Card 2 -->
            <div class="cc-fair-card">
              <img src="/images/fair_gandhi.jpg" alt="Gandhi Shilp Bazaar & National Craft Expo" class="cc-fair-thumb">
              <div class="cc-fair-info">
                <div class="cc-fair-badges-row">
                  <span class="cc-fair-status-pill cc-status-upcoming">Upcoming</span>
                  <span class="cc-fair-dist-pill">📍 440.9 km</span>
                </div>
                <h4 class="cc-fair-title" title="Gandhi Shilp Bazaar & National Craft Expo">Gandhi Shilp Bazaar &amp; National Craft Expo</h4>
                <div class="cc-fair-meta-row">
                  <span class="cc-fair-meta-item">📅 5 Nov 2026 – 14 Nov 2026</span>
                  <span class="cc-fair-meta-item">📍 Jaipur</span>
                </div>
              </div>
            </div>

            <!-- Exhibition Card 3 -->
            <div class="cc-fair-card">
              <img src="/images/fair_saras.jpg" alt="National Shilpgram Crafts Festival" class="cc-fair-thumb">
              <div class="cc-fair-info">
                <div class="cc-fair-badges-row">
                  <span class="cc-fair-status-pill cc-status-open">Application Open (28d left)</span>
                  <span class="cc-fair-dist-pill">📍 413.5 km</span>
                </div>
                <h4 class="cc-fair-title" title="National Shilpgram Crafts Festival">National Shilpgram Crafts Festival</h4>
                <div class="cc-fair-meta-row">
                  <span class="cc-fair-meta-item">📅 21 Dec 2026 – 30 Dec 2026</span>
                  <span class="cc-fair-meta-item">📍 Udaipur</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Hidden containers for dynamic API loads so CraftMarketDiscovery doesn't error -->
        <div style="display:none;">
            <span id="locationDisplay">Bhopal, Madhya Pradesh</span>
            <span id="marketLocationBadge"><span id="marketStatusDot"></span><span id="marketStatusText"></span></span>
            <div id="marketLocationErrorBox"></div>
            <select id="marketCategorySelect"><option value="all" selected>All</option></select>
            <select id="marketRadiusSelect"><option value="25" selected>25</option></select>
            <input type="checkbox" id="marketContactFilter">
            <input type="text" id="marketCitySearchInput">
            <div id="placesSetupBanner"></div>
            <span id="localMarketsCount"></span>
            <div id="localLoading"></div>
            <div id="localMarketsList"></div>
            <span id="marketEventsCount"></span>
            <div id="eventsLoading"></div>
            <div id="marketEventsList"></div>
            <span id="digitalMarketsCount"></span>
            <div id="digitalLoading"></div>
            <div id="digitalMarketsList"></div>
            <span id="marketConnectionsCount"></span>
            <div id="marketConnectionsList"></div>
            <div id="marketLocalSection"></div>
            <div id="marketEventsSection"></div>
            <div id="marketDigitalSection"></div>
            <div id="marketConnectionsSection"></div>
        </div>
    </div>

    <!-- Onboarding Guidance & Checklist Modal -->
    <div id="marketOnboardingModal" class="market-modal-overlay">
        <div class="market-modal-card">
            <button type="button" class="market-modal-close" onclick="document.getElementById('marketOnboardingModal').style.display='none'">✕</button>
            <div style="margin-bottom: 16px;">
                <span style="font-size: 11px; background: #EAF4F2; color: #075C55; font-weight: 700; padding: 3px 8px; border-radius: 6px;" id="onboardingModalPlatformType">Seller Channel</span>
                <h3 id="onboardingModalPlatformName" style="font-size: 20px; font-weight: 700; color: #075C55; margin: 6px 0 0 0;">Platform Onboarding</h3>
            </div>

            <div id="onboardingModalFeeInfo" style="background: #F8FAFC; border: 1px solid #E2E8F0; padding: 10px 12px; border-radius: 8px; font-size: 12.5px; margin-bottom: 14px; line-height: 1.45;"></div>

            <h4 style="font-size: 13.5px; margin: 0 0 8px 0; color: #0F172A;">📋 Required Seller Documents:</h4>
            <ul id="onboardingModalDocsList" style="list-style: none; margin: 0 0 16px 0; padding: 0;"></ul>

            <div style="background: #FFFBEB; border: 1px solid #FEF3C7; padding: 12px; border-radius: 8px; font-size: 12.5px; color: #92400E; margin-bottom: 16px; line-height: 1.45;">
                💡 <strong>Artisan Registration Process:</strong> First, click below to open the official seller registration portal and complete your account setup. Then update your status here so CraftConnect can track your store progress.
            </div>

            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 12.5px; font-weight: 600; color: #334155; margin-bottom: 4px;">Update Your Onboarding Status:</label>
                <select id="onboardingStageSelect" class="filter-select" style="width: 100%;">
                    <option value="not_started">Not Started (Reviewing requirements)</option>
                    <option value="external_registration">Registered on Official Seller Portal</option>
                    <option value="awaiting_approval">Submitted Documents / Awaiting Approval</option>
                    <option value="connected">Active Seller Account (Storefront Live)</option>
                </select>
            </div>

            <div style="margin-bottom: 18px;">
                <label style="display: block; font-size: 12.5px; font-weight: 600; color: #334155; margin-bottom: 4px;">Merchant / Seller ID (Optional):</label>
                <input type="text" id="onboardingMerchantIdInput" class="filter-search-input" style="width: 100%;" placeholder="e.g. A2XXXXXX or FLIP_XXXX">
            </div>

            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <a id="onboardingModalSellerUrl" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-teal btn-sm" style="flex: 1; text-align: center;">
                    🚀 Open Verified Seller Portal ↗
                </a>
                <button type="button" class="btn btn-orange btn-sm" style="flex: 1;" onclick="CraftMarketDiscovery.updateOnboardingStage()">
                    💾 Save Onboarding Status
                </button>
            </div>
        </div>
    </div>

    <!-- Authorized API Configuration Modal -->
    <div id="marketApiConfigModal" class="market-modal-overlay">
        <div class="market-modal-card">
            <button type="button" class="market-modal-close" onclick="CraftMarketDiscovery.closeApiConfigModal()">✕</button>
            <div style="margin-bottom: 16px;">
                <span style="font-size: 11px; background: #EFF6FF; color: #1D4ED8; font-weight: 700; padding: 3px 8px; border-radius: 6px;">Developer API Integration</span>
                <h3 id="apiConfigModalPlatformName" style="font-size: 20px; font-weight: 700; color: #075C55; margin: 6px 0 0 0;">Configure Developer API</h3>
                <p id="apiConfigModalApiName" style="font-size: 12.5px; color: #64748B; margin: 4px 0 0 0;"></p>
            </div>

            <div style="background: #F1F5F9; border: 1px solid #E2E8F0; padding: 12px; border-radius: 8px; font-size: 12.5px; margin-bottom: 16px; line-height: 1.45;">
                <strong>Official Access Requirements:</strong><br>
                <span id="apiConfigModalRequirements" style="color: #475569;"></span><br>
                <a id="apiConfigModalDocLink" href="#" target="_blank" rel="noopener noreferrer" style="color: #075C55; font-weight: 600; text-decoration: underline; margin-top: 4px; display: inline-block;">
                    View Official Developer Documentation ↗
                </a>
            </div>

            <div style="margin-bottom: 12px;">
                <label style="display: block; font-size: 12.5px; font-weight: 600; color: #334155; margin-bottom: 4px;">Developer App / Client ID:</label>
                <input type="text" id="apiConfigClientId" class="filter-search-input" style="width: 100%;" placeholder="e.g. amzn1.sp.solution.xxxx">
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 12.5px; font-weight: 600; color: #334155; margin-bottom: 4px;">Developer Client Secret / App Key:</label>
                <input type="password" id="apiConfigClientSecret" class="filter-search-input" style="width: 100%;" placeholder="••••••••••••••••">
            </div>

            <div style="display: flex; gap: 10px;">
                <button type="button" class="btn btn-outline-teal btn-sm" style="flex: 1;" onclick="CraftMarketDiscovery.closeApiConfigModal()">Cancel</button>
                <button type="button" class="btn btn-teal btn-sm" style="flex: 1;" onclick="CraftMarketDiscovery.saveApiCredentials()">Authorize API Connection</button>
            </div>
        </div>
    </div>

    <!-- ================= CITY / LOCATION SELECTOR MODAL (SPA) ================= -->
    <div id="cityPickerModal" class="market-modal-overlay" style="display:none;">
      <div class="market-modal-card" style="max-width: 480px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
          <h3 style="font-size:17px; font-weight:700; color:#0F172A; margin:0; display:flex; align-items:center; gap:8px;">
            <span>📍</span> Select Your Location
          </h3>
          <button type="button" class="market-modal-close" onclick="closeCityModal()">✕</button>
        </div>
        <p style="font-size:13px; color:#64748B; margin:0 0 14px; line-height:1.45;">
          Search any city, state, or country worldwide (e.g. Agra, London, Jaipur, New York, Kathmandu) to find real craft markets and stores.
        </p>

        <div style="display:flex; gap:8px; margin-bottom:14px;">
          <input type="text" id="citySearchInput" placeholder="Enter city name (e.g. Agra, London, Jaipur, New York)..." style="flex:1; padding:10px 14px; border:1px solid #CBD5E1; border-radius:10px; font-size:13.5px; outline:none;" onkeyup="if(event.key==='Enter')applySearchedCity()">
          <button type="button" id="btnSetCityModal" onclick="applySearchedCity()" style="background:#075C55; color:white; border:none; padding:10px 18px; border-radius:10px; font-size:13px; font-weight:600; cursor:pointer;">Set</button>
        </div>

        <button type="button" onclick="closeCityModal(); CraftMarketDiscovery.requestGPSLocation();" style="width:100%; background:#E8F5E9; color:#166534; border:1px solid #BBF7D0; padding:10px 14px; border-radius:10px; font-size:13px; font-weight:600; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; margin-bottom:18px;">
          <span>📡</span> Detect My Live GPS Location
        </button>

        <div style="font-size:11.5px; font-weight:700; color:#64748B; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px;">
          Popular Artisan Locations
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:8px;">
          <button type="button" class="cc-tag-pill" style="cursor:pointer; padding:6px 12px; font-size:12.5px;" onclick="chooseCityPreset('Agra', 'Uttar Pradesh', 27.1753, 78.0098, 'India')">🕌 Agra, UP</button>
          <button type="button" class="cc-tag-pill" style="cursor:pointer; padding:6px 12px; font-size:12.5px;" onclick="chooseCityPreset('Jaipur', 'Rajasthan', 26.9124, 75.7873, 'India')">🏺 Jaipur, RJ</button>
          <button type="button" class="cc-tag-pill" style="cursor:pointer; padding:6px 12px; font-size:12.5px;" onclick="chooseCityPreset('Udaipur', 'Rajasthan', 24.5854, 73.7125, 'India')">🎨 Udaipur, RJ</button>
          <button type="button" class="cc-tag-pill" style="cursor:pointer; padding:6px 12px; font-size:12.5px;" onclick="chooseCityPreset('Mumbai', 'Maharashtra', 19.0760, 72.8777, 'India')">🌊 Mumbai, MH</button>
          <button type="button" class="cc-tag-pill" style="cursor:pointer; padding:6px 12px; font-size:12.5px;" onclick="chooseCityPreset('Delhi', 'Delhi NCR', 28.6139, 77.2090, 'India')">🎪 Delhi NCR</button>
          <button type="button" class="cc-tag-pill" style="cursor:pointer; padding:6px 12px; font-size:12.5px;" onclick="chooseCityPreset('Bhopal', 'Madhya Pradesh', 23.2599, 77.4126, 'India')">🏛️ Bhopal, MP</button>
          <button type="button" class="cc-tag-pill" style="cursor:pointer; padding:6px 12px; font-size:12.5px;" onclick="chooseCityPreset('Kathmandu', 'Bagmati', 27.7172, 85.3240, 'Nepal')">🏔️ Kathmandu, NP</button>
          <button type="button" class="cc-tag-pill" style="cursor:pointer; padding:6px 12px; font-size:12.5px;" onclick="chooseCityPreset('London', 'Greater London', 51.5074, -0.1278, 'United Kingdom')">🎡 London, UK</button>
          <button type="button" class="cc-tag-pill" style="cursor:pointer; padding:6px 12px; font-size:12.5px;" onclick="chooseCityPreset('New York', 'New York', 40.7128, -74.0060, 'USA')">🗽 New York, USA</button>
        </div>
      </div>
    </div>

    <!-- SPA Map Initialization Trigger -->
    <script>
        window.spaMapMarkers = [];
        window.initSpaMap = function() {
            if (window.spaMap) {
                window.spaMap.invalidateSize();
                return;
            }
            const mapEl = document.getElementById("spaArtisanMap");
            if (!mapEl || typeof L === 'undefined') return;

            const st = (window.CraftMarketDiscovery && window.CraftMarketDiscovery.getState) ? window.CraftMarketDiscovery.getState() : {};
            const initialCenter = (st.lat && st.lng) ? [st.lat, st.lng] : [23.2599, 77.4126];

            window.spaMap = L.map("spaArtisanMap", {
                center: initialCenter,
                zoom: 13,
                zoomControl: false,
                attributionControl: false
            });

            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                maxZoom: 19,
                subdomains: 'abcd'
            }).addTo(window.spaMap);

            if (st.placesData && st.placesData.places) {
                window.updateSpaMap(st.lat || initialCenter[0], st.lng || initialCenter[1], st.placesData.places, st.radius || 25);
            }
        };

        window.updateSpaMap = function(lat, lng, places = [], radiusKm = 25) {
            if (!window.spaMap || !lat || !lng) return;
            const zoom = radiusKm <= 5 ? 15 : radiusKm <= 10 ? 14 : radiusKm <= 25 ? 13 : 11;
            window.spaMap.setView([lat, lng], zoom);

            if (window.spaMapMarkers) {
                window.spaMapMarkers.forEach(m => window.spaMap.removeLayer(m));
            }
            window.spaMapMarkers = [];

            // User pulse icon
            const userIcon = L.divIcon({
                className: 'cc-user-map-marker',
                html: '<div class="cc-pulse-dot"><div class="cc-pulse-ring"></div></div>',
                iconSize: [24, 24],
                iconAnchor: [12, 12]
            });
            const userMarker = L.marker([lat, lng], { icon: userIcon, zIndexOffset: 1000 })
                .addTo(window.spaMap)
                .bindPopup('<strong>📍 Your Location</strong>');
            window.spaMapMarkers.push(userMarker);

            // Discovered places pins
            places.slice(0, 15).forEach(p => {
                if (!p.lat || !p.lng) return;
                const icon = L.divIcon({
                    className: 'custom-leaflet-marker',
                    html: `<div class="cc-map-pin pin-green">${p.name.length > 14 ? p.name.substring(0, 14) + '…' : p.name}</div>`,
                    iconSize: [90, 24],
                    iconAnchor: [45, 12]
                });
                const m = L.marker([p.lat, p.lng], { icon })
                    .addTo(window.spaMap)
                    .bindPopup(`<strong>${p.name}</strong><br><span style="font-size:11px;">${p.address || ''}</span><br><a href="${p.directionsUrl}" target="_blank" rel="noopener noreferrer" style="font-size:11px;color:#075C55;font-weight:600;">Directions ↗</a>`);
                window.spaMapMarkers.push(m);
            });
        };

        // When user navigates to markets screen in SPA
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(window.initSpaMap, 400);
        });
        window.addEventListener('hashchange', function() {
            if (window.location.hash === '#markets') {
                setTimeout(window.initSpaMap, 150);
            }
        });
    </script>
</section>

