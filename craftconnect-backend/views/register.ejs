<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - CraftConnect</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: #FAF5EC;
            color: #173F3A;
        }
        .heading {
            font-family: 'Outfit', sans-serif;
        }

        .input-field {
            width: 100%;
            padding: 13px 15px;
            border: 1px solid #d8ded7;
            border-radius: 10px;
            outline: none;
            background: #ffffff;
            font-size: 14px;
            transition: 0.2s;
        }

        .input-field:focus {
            border-color: #075C55;
            box-shadow: 0 0 0 3px rgba(7, 92, 85, 0.08);
        }

        .register-btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 10px;
            background: #075C55;
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

        .register-btn:hover {
            background: #064d47;
        }

        .google-btn {
            width: 100%;
            padding: 13px;
            border: 1px solid #d8ded7;
            border-radius: 10px;
            background: white;
            color: #333;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: 0.2s;
        }

        .google-btn:hover {
            background: #f8f8f8;
        }

        .divider {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #8a918d;
            font-size: 13px;
            margin: 22px 0;
        }

        .divider::before,
        .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #ddd;
        }
    </style>
</head>
<body>
<div class="min-h-screen flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-5xl bg-white rounded-3xl shadow-xl overflow-hidden flex flex-col md:flex-row">
        <!-- Left Section -->
        <div class="md:w-5/12 bg-[#075C55] text-white p-10 flex flex-col justify-center">
            <div class="mb-8">
                <div class="flex items-center gap-3 mb-6">
                    <div class="text-3xl">🌿</div>
                    <h1 class="heading text-2xl font-bold">
                        CraftConnect
                    </h1>
                </div>

                <h2 class="heading text-4xl font-bold leading-tight mb-5">
                    Grow your craft.
                    <br>
                    Grow your business.
                </h2>

                <p class="text-white/80 leading-relaxed">
                    Create your CraftConnect account and get AI-powered support
                    for your products, pricing, descriptions and business growth.
                </p>
            </div>

            <div class="space-y-4 text-sm text-white/85">

                <div class="flex gap-3">
                    <span>✦</span>
                    <span>AI-powered product assistance</span>
                </div>

                <div class="flex gap-3">
                    <span>✦</span>
                    <span>Smart pricing and market insights</span>
                </div>

                <div class="flex gap-3">
                    <span>✦</span>
                    <span>Track your business performance</span>
                </div>
            </div>
        </div>

        <!-- Registration Form -->
        <div class="md:w-7/12 p-8 md:p-10">
            <div class="max-w-lg mx-auto">
                <div class="mb-7">
                    <h2 class="heading text-3xl font-bold text-[#173F3A]">
                        Create your account
                    </h2>
                    <p class="text-gray-500 text-sm mt-2">
                        Join CraftConnect and start managing your craft business.
                    </p>
                </div>

                <form action="/register" method="POST">
                    <!-- Name -->
                    <div class="mb-4">
                        <label class="block text-sm font-medium mb-2">
                            Full Name
                        </label>

                        <input
                            type="text"
                            name="name"
                            class="input-field"
                            placeholder="Enter your full name"
                            required
                        >
                    </div>

                    <!-- Email -->
                    <div class="mb-4">
                        <label class="block text-sm font-medium mb-2">
                            Email Address
                        </label>

                        <input
                            type="email"
                            name="email"
                            class="input-field"
                            placeholder="you@example.com"
                            required
                        >
                    </div>


                    <!-- Phone -->
                    <div class="mb-4">
                        <label class="block text-sm font-medium mb-2">
                            Phone Number
                        </label>

                        <input
                            type="tel"
                            name="phone"
                            class="input-field"
                            placeholder="Enter your phone number"
                            required
                        >
                    </div>


                    <!-- Craft -->
                    <div class="mb-4">
                        <label class="block text-sm font-medium mb-2">
                            Craft / Business Type
                        </label>

                        <select
                            name="craft"
                            class="input-field"
                            required>
                            <option value="">Select your craft</option>
                            <option value="handicraft">Handicrafts</option>
                            <option value="textile">Textiles</option>
                            <option value="pottery">Pottery</option>
                            <option value="woodwork">Woodwork</option>
                            <option value="jewellery">Jewellery</option>
                            <option value="painting">Painting</option>
                            <option value="embroidery">Embroidery</option>
                            <option value="other">Other</option>
                        </select>
                    </div>


                    <!-- Location -->
                    <div class="mb-4">
                        <label class="block text-sm font-medium mb-2">
                            State
                        </label>

                        <input
                            type="text"
                            name="state"
                            class="input-field"
                            placeholder="e.g. Madhya Pradesh"
                            required
                        >
                    </div>


                    <!-- Password -->
                    <div class="mb-4">
                        <label class="block text-sm font-medium mb-2">
                            Password
                        </label>

                        <input
                            type="password"
                            name="password"
                            class="input-field"
                            placeholder="Create a password"
                            required
                            minlength="6"
                        >
                    </div>


                    <!-- Confirm Password -->
                    <div class="mb-5">
                        <label class="block text-sm font-medium mb-2">
                            Confirm Password
                        </label>

                        <input
                            type="password"
                            name="confirmPassword"
                            class="input-field"
                            placeholder="Confirm your password"
                            required
                            minlength="6"
                        >
                    </div>


                    <!-- Terms -->
                    <div class="flex items-start gap-2 mb-5">

                        <input
                            type="checkbox"
                            name="terms"
                            required
                            class="mt-1"
                        >

                        <p class="text-xs text-gray-500">
                            I agree to the CraftConnect terms and privacy policy.
                        </p>
                    </div>

                    <!-- Register -->
                    <button
                        type="submit"
                        class="register-btn"
                    >
                        Create Account
                    </button>
                </form>

                <div class="divider">              OR          </div>

                <!-- Google -->
                <button
                    type="button"
                    class="google-btn"
                    onclick="googleSignIn()"             >
                    <span class="mr-2">G</span>
                    Sign up with Google
                </button>
                <p class="text-center text-sm text-gray-500 mt-6">
                    Already have an account?
                    <a                   href="/login" class="font-semibold text-[#075C55] hover:underline" >
                        Sign in
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>
<script>
    function googleSignIn() {
        window.location.href = "/auth/google";
    }
</script>
</body>
</html>